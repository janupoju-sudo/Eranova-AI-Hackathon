# Copy to .env.local and fill in. Never commit .env.local.
# Server-only unless noted: do not add the NEXT_PUBLIC_ prefix to keys.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
TMS_API_BASE=
TMS_API_KEY=
# Set to 1 to let the agent write to the TMS (cover, costs, rate con, appointment, notes). Anything else = dry run.
TMS_WRITES=
# Browser-visible base URL of the TMS web app, used only for the "Open in TMS" link (no secrets).
NEXT_PUBLIC_TMS_UI_URL=
